rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 1 & Phase 4.1: Global Safety Net (Default-Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Reusable Hardened Global Helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isBootstrappedSuperAdmin() {
      return isSignedIn() && request.auth.token.email == 'creazyprogrammer0@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedSuperAdmin() || (
        isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isContentAdmin() {
      return isBootstrappedSuperAdmin() || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role in ['super_admin', 'content_manager']
      );
    }

    // Validation Helpers (Pillar 2: Anti-Update-Gap)
    function isValidAdminRole(data) {
      return data.keys().hasAll(['uid', 'email', 'role', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'email', 'role', 'createdAt']) &&
        isValidId(data.uid) &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 254 &&
        data.role is string && data.role in ['super_admin', 'content_manager', 'inquiry_manager'] &&
        data.createdAt is timestamp;
    }

    function isValidProject(data) {
      return data.keys().hasAll([
          'id', 'slug', 'name', 'location', 'category', 'shortDescription',
          'completionStatus', 'publicationStatus', 'isDemonstration', 'ownerId', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'slug', 'name', 'location', 'category', 'shortDescription', 'fullDescription',
          'completionStatus', 'publicationStatus', 'isDemonstration', 'ownerId', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        data.slug is string && data.slug.size() >= 2 && data.slug.size() <= 128 && data.slug.matches('^[a-z0-9\\-]+$') &&
        data.name is string && data.name.size() >= 2 && data.name.size() <= 160 &&
        data.location is string && data.location.size() >= 2 && data.location.size() <= 200 &&
        data.category is string && data.category.size() >= 2 && data.category.size() <= 80 &&
        data.shortDescription is string && data.shortDescription.size() >= 2 && data.shortDescription.size() <= 500 &&
        (!('fullDescription' in data) || (data.fullDescription is string && data.fullDescription.size() <= 3000)) &&
        data.completionStatus is string && data.completionStatus in ['Completed', 'Under Construction', 'Planning', 'Unconfirmed'] &&
        data.publicationStatus is string && data.publicationStatus in ['draft', 'published', 'archived'] &&
        data.isDemonstration is bool &&
        isValidId(data.ownerId) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidBuilding(data) {
      return data.keys().hasAll([
          'id', 'projectId', 'name', 'code', 'overview', 'confirmedFloors',
          'publicationStatus', 'ownerId', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'projectId', 'name', 'code', 'overview', 'confirmedFloors',
          'publicationStatus', 'ownerId', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        isValidId(data.projectId) &&
        data.name is string && data.name.size() >= 2 && data.name.size() <= 160 &&
        data.code is string && data.code.size() >= 1 && data.code.size() <= 32 &&
        data.overview is string && data.overview.size() >= 2 && data.overview.size() <= 1500 &&
        data.confirmedFloors is int && data.confirmedFloors >= 1 && data.confirmedFloors <= 200 &&
        data.publicationStatus is string && data.publicationStatus in ['draft', 'published', 'archived'] &&
        isValidId(data.ownerId) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidFloor(data) {
      return data.keys().hasAll([
          'id', 'projectId', 'buildingId', 'floorNumber', 'label',
          'publicationStatus', 'ownerId', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'projectId', 'buildingId', 'floorNumber', 'label',
          'publicationStatus', 'ownerId', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        isValidId(data.projectId) &&
        isValidId(data.buildingId) &&
        data.floorNumber is int && data.floorNumber >= -5 && data.floorNumber <= 200 &&
        data.label is string && data.label.size() >= 1 && data.label.size() <= 80 &&
        data.publicationStatus is string && data.publicationStatus in ['draft', 'published', 'archived'] &&
        isValidId(data.ownerId) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidApartment(data) {
      return data.keys().hasAll([
          'id', 'projectId', 'buildingId', 'floorId', 'unitCode', 'title',
          'bedrooms', 'bathrooms', 'areaSqm', 'areaConvention', 'priceStatus',
          'priceAmount', 'availabilityStatus', 'publicationStatus', 'tourAssetId',
          'isDemonstration', 'ownerId', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'projectId', 'buildingId', 'floorId', 'unitCode', 'title',
          'bedrooms', 'bathrooms', 'areaSqm', 'areaConvention', 'priceStatus',
          'priceAmount', 'availabilityStatus', 'publicationStatus', 'tourAssetId',
          'isDemonstration', 'ownerId', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        isValidId(data.projectId) &&
        isValidId(data.buildingId) &&
        isValidId(data.floorId) &&
        data.unitCode is string && data.unitCode.size() >= 1 && data.unitCode.size() <= 40 &&
        data.title is string && data.title.size() >= 2 && data.title.size() <= 160 &&
        data.bedrooms is int && data.bedrooms >= 0 && data.bedrooms <= 20 &&
        data.bathrooms is int && data.bathrooms >= 1 && data.bathrooms <= 20 &&
        (data.areaSqm is int || data.areaSqm is float) && data.areaSqm >= 10 && data.areaSqm <= 5000 &&
        data.areaConvention is string && data.areaConvention.size() >= 2 && data.areaConvention.size() <= 64 &&
        data.priceStatus is string && data.priceStatus in ['published', 'price_on_request', 'unconfirmed'] &&
        (data.priceAmount is int || data.priceAmount is float) && data.priceAmount >= 0 && data.priceAmount <= 500000000 &&
        data.availabilityStatus is string && data.availabilityStatus in ['available', 'reserved', 'sold', 'unavailable'] &&
        data.publicationStatus is string && data.publicationStatus in ['draft', 'published', 'archived'] &&
        data.tourAssetId is string && data.tourAssetId.size() <= 128 &&
        data.isDemonstration is bool &&
        isValidId(data.ownerId) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidTourManifest(data) {
      return data.keys().hasAll([
          'id', 'projectId', 'buildingId', 'floorId', 'apartmentId',
          'provider', 'captureStatus', 'externalEmbedUrl', 'ownerId', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'projectId', 'buildingId', 'floorId', 'apartmentId',
          'provider', 'captureStatus', 'externalEmbedUrl', 'ownerId', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        isValidId(data.projectId) &&
        isValidId(data.buildingId) &&
        isValidId(data.floorId) &&
        isValidId(data.apartmentId) &&
        data.provider is string && data.provider in ['threejs_architectural_twin', 'matterport_embed', 'custom_webgl'] &&
        data.captureStatus is string && data.captureStatus in [
          'not_captured', 'capture_scheduled', 'processing', 'ready_for_review',
          'approved_for_publication', 'published', 'unavailable'
        ] &&
        data.externalEmbedUrl is string && data.externalEmbedUrl.size() <= 500 &&
        isValidId(data.ownerId) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidInquiry(data) {
      return data.keys().hasAll([
          'id', 'customerName', 'customerEmail', 'customerPhone', 'preferredContactMethod',
          'inquiryType', 'projectId', 'apartmentId', 'preferredDate', 'preferredTimeWindow',
          'message', 'status', 'internalNotes', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'customerName', 'customerEmail', 'customerPhone', 'preferredContactMethod',
          'inquiryType', 'projectId', 'apartmentId', 'preferredDate', 'preferredTimeWindow',
          'message', 'status', 'internalNotes', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        data.customerName is string && data.customerName.size() >= 2 && data.customerName.size() <= 120 &&
        data.customerEmail is string && data.customerEmail.size() >= 3 && data.customerEmail.size() <= 254 &&
        data.customerPhone is string && data.customerPhone.size() <= 40 &&
        data.preferredContactMethod is string && data.preferredContactMethod in ['email', 'phone', 'either'] &&
        data.inquiryType is string && data.inquiryType in ['general_inquiry', 'property_details', 'site_visit_request'] &&
        data.projectId is string && data.projectId.size() <= 128 &&
        data.apartmentId is string && data.apartmentId.size() <= 128 &&
        data.preferredDate is string && data.preferredDate.size() <= 40 &&
        data.preferredTimeWindow is string && data.preferredTimeWindow.size() <= 64 &&
        data.message is string && data.message.size() >= 5 && data.message.size() <= 2000 &&
        data.status is string && data.status in [
          'new', 'contacted', 'follow_up_required', 'site_visit_requested', 'site_visit_confirmed', 'closed'
        ] &&
        data.internalNotes is string && data.internalNotes.size() <= 2000 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // Collection 1: /admins/{adminUid}
    match /admins/{adminUid} {
      allow get: if isValidId(adminUid) && (
        (isSignedIn() && request.auth.uid == adminUid) || isBootstrappedSuperAdmin()
      );
      allow list: if isBootstrappedSuperAdmin();
      allow create: if isBootstrappedSuperAdmin() &&
        isValidId(adminUid) &&
        isValidAdminRole(incoming()) &&
        incoming().uid == adminUid &&
        incoming().createdAt == request.time;
      allow update: if isBootstrappedSuperAdmin() &&
        isValidId(adminUid) &&
        isValidAdminRole(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly(['role', 'email']);
      allow delete: if isBootstrappedSuperAdmin() && isValidId(adminUid);
    }

    // Collection 2: /projects/{projectId}
    match /projects/{projectId} {
      allow get: if isValidId(projectId) && (
        existing().publicationStatus == 'published' || isAdmin()
      );
      allow list: if existing().publicationStatus == 'published' || isAdmin();
      allow create: if isContentAdmin() &&
        isValidId(projectId) &&
        isValidProject(incoming()) &&
        incoming().id == projectId &&
        incoming().ownerId == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isContentAdmin() &&
        isValidId(projectId) &&
        isValidProject(incoming()) &&
        incoming().id == existing().id &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          incoming().diff(existing()).affectedKeys().hasOnly([
            'slug', 'name', 'location', 'category', 'shortDescription', 'fullDescription',
            'completionStatus', 'publicationStatus', 'isDemonstration', 'updatedAt'
          ])
        );
      allow delete: if isBootstrappedSuperAdmin() && isValidId(projectId);
    }

    // Collection 3: /buildings/{buildingId}
    match /buildings/{buildingId} {
      allow get: if isValidId(buildingId) && (
        existing().publicationStatus == 'published' || isAdmin()
      );
      allow list: if existing().publicationStatus == 'published' || isAdmin();
      allow create: if isContentAdmin() &&
        isValidId(buildingId) &&
        isValidBuilding(incoming()) &&
        incoming().id == buildingId &&
        incoming().ownerId == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/projects/$(incoming().projectId));
      allow update: if isContentAdmin() &&
        isValidId(buildingId) &&
        isValidBuilding(incoming()) &&
        incoming().id == existing().id &&
        incoming().projectId == existing().projectId &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'name', 'code', 'overview', 'confirmedFloors', 'publicationStatus', 'updatedAt'
        ]);
      allow delete: if isBootstrappedSuperAdmin() && isValidId(buildingId);
    }

    // Collection 4: /floors/{floorId}
    match /floors/{floorId} {
      allow get: if isValidId(floorId) && (
        existing().publicationStatus == 'published' || isAdmin()
      );
      allow list: if existing().publicationStatus == 'published' || isAdmin();
      allow create: if isContentAdmin() &&
        isValidId(floorId) &&
        isValidFloor(incoming()) &&
        incoming().id == floorId &&
        incoming().ownerId == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/projects/$(incoming().projectId)) &&
        exists(/databases/$(database)/documents/buildings/$(incoming().buildingId));
      allow update: if isContentAdmin() &&
        isValidId(floorId) &&
        isValidFloor(incoming()) &&
        incoming().id == existing().id &&
        incoming().projectId == existing().projectId &&
        incoming().buildingId == existing().buildingId &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'floorNumber', 'label', 'publicationStatus', 'updatedAt'
        ]);
      allow delete: if isBootstrappedSuperAdmin() && isValidId(floorId);
    }

    // Collection 5: /apartments/{apartmentId}
    match /apartments/{apartmentId} {
      allow get: if isValidId(apartmentId) && (
        existing().publicationStatus == 'published' || isAdmin()
      );
      allow list: if existing().publicationStatus == 'published' || isAdmin();
      allow create: if isContentAdmin() &&
        isValidId(apartmentId) &&
        isValidApartment(incoming()) &&
        incoming().id == apartmentId &&
        incoming().ownerId == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/projects/$(incoming().projectId)) &&
        exists(/databases/$(database)/documents/buildings/$(incoming().buildingId)) &&
        exists(/databases/$(database)/documents/floors/$(incoming().floorId));
      allow update: if isContentAdmin() &&
        isValidId(apartmentId) &&
        isValidApartment(incoming()) &&
        incoming().id == existing().id &&
        incoming().projectId == existing().projectId &&
        incoming().buildingId == existing().buildingId &&
        incoming().floorId == existing().floorId &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'unitCode', 'title', 'bedrooms', 'bathrooms', 'areaSqm', 'areaConvention',
          'priceStatus', 'priceAmount', 'availabilityStatus', 'publicationStatus',
          'tourAssetId', 'isDemonstration', 'updatedAt'
        ]);
      allow delete: if isBootstrappedSuperAdmin() && isValidId(apartmentId);
    }

    // Collection 6: /tourManifests/{manifestId}
    match /tourManifests/{manifestId} {
      allow get: if isValidId(manifestId) && (
        existing().captureStatus == 'published' || isAdmin()
      );
      allow list: if existing().captureStatus == 'published' || isAdmin();
      allow create: if isContentAdmin() &&
        isValidId(manifestId) &&
        isValidTourManifest(incoming()) &&
        incoming().id == manifestId &&
        incoming().ownerId == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/apartments/$(incoming().apartmentId));
      allow update: if isContentAdmin() &&
        isValidId(manifestId) &&
        isValidTourManifest(incoming()) &&
        incoming().id == existing().id &&
        incoming().projectId == existing().projectId &&
        incoming().buildingId == existing().buildingId &&
        incoming().floorId == existing().floorId &&
        incoming().apartmentId == existing().apartmentId &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'provider', 'captureStatus', 'externalEmbedUrl', 'updatedAt'
        ]);
      allow delete: if isBootstrappedSuperAdmin() && isValidId(manifestId);
    }

    // Collection 7: /inquiries/{inquiryId} (PII Isolated to Admins)
    match /inquiries/{inquiryId} {
      allow get: if isValidId(inquiryId) && isAdmin();
      allow list: if isAdmin();
      // Public visitors can submit validated inquiries with strict initial state
      allow create: if isValidId(inquiryId) &&
        isValidInquiry(incoming()) &&
        incoming().id == inquiryId &&
        incoming().status in ['new', 'site_visit_requested'] &&
        incoming().internalNotes == '' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      // Only authorized admins can update inquiry status or internal notes
      allow update: if isAdmin() &&
        isValidId(inquiryId) &&
        isValidInquiry(incoming()) &&
        incoming().id == existing().id &&
        incoming().customerName == existing().customerName &&
        incoming().customerEmail == existing().customerEmail &&
        incoming().customerPhone == existing().customerPhone &&
        incoming().inquiryType == existing().inquiryType &&
        incoming().projectId == existing().projectId &&
        incoming().apartmentId == existing().apartmentId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'status', 'internalNotes', 'preferredDate', 'preferredTimeWindow', 'updatedAt'
        ]);
      allow delete: if isBootstrappedSuperAdmin() && isValidId(inquiryId);
    }
  }
}
